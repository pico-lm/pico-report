# Pico Report Environment Variables
# Obvs don't commit the real thing

PICO_API_KEY=your_api_key_here

# Required: Your lab hash
PICO_LAB_HASH=your_lab_hash_here

# Optional: Base URL (defaults to production)
PICO_BASE_URL=http://localhost:3000/api/report

# Optional: Experiment name
PICO_EXPERIMENT_NAME=my-experiment

# Optional: Request timeout in seconds
PICO_TIMEOUT=30

# Optional: Maximum retry attempts
PICO_MAX_RETRIES=3
