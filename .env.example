# Pico Report Configuration
# Copy this file to .env and fill in your values

# Required: Your Pico API key
PICO_API_KEY=pk_jGdg3EKlwBRkqQ4Vsn3I8MpY6KnSbZem

# Optional: Pico backend URL (defaults to https://api.picolm.io)
PICO_BASE_URL=http://localhost:3000/api/

# Optional: Lab hash for organizing experiments
PICO_LAB_HASH=your-project-id

# Optional: Experiment name
PICO_EXPERIMENT_NAME=your-experiment-name

# Optional: Request timeout in seconds (default: 30)
PICO_TIMEOUT=30

# Optional: Maximum retry attempts (default: 3)
PICO_MAX_RETRIES=3